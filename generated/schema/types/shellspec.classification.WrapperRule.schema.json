    "shellspec.classification.WrapperRule": {
      "title": "WrapperRule",
      "description": "A program that runs the program after it (§ 6.2 step 1). It takes its flags, then `positionals` words, then words up to and including `until`; `assignments` takes `X=y` words. It is no wrapper when the next word is in `unless_next`; a word of `skip_next` right after it is taken too. When one of its words is the `after` of an `implies` entry, the words after the wrapper are arguments of that entry's program.",
      "x-ess-name": "shellspec.classification.WrapperRule",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
