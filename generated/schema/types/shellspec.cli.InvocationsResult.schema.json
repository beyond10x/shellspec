      "x-ess-kind": "newtype",
      "type": "string"
    },
    "shellspec.cli.InvocationsResult": {
      "title": "InvocationsResult",
      "x-ess-name": "shellspec.cli.InvocationsResult",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "ruleset": {
          "$ref": "#/$defs/shellspec.classification.RulesetDigest"
