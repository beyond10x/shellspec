          "type": "integer"
        }
      },
      "required": [
        "op",
        "after"
      ],
      "additionalProperties": false
    },
    "shellspec.invocation.Invocation": {
      "title": "Invocation",
      "description": "One simple command. `argv` and `redirects` hold `shellspec.word.Word` and `shellspec.word.Redirect` values; they are `Json` here because the ess-cli/2 binding projects no union.",
      "x-ess-name": "shellspec.invocation.Invocation",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "index": {
          "type": "integer"
        },
        "path": {
          "description": "Position in the tree, statement and child indices from the script's root.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "program": {
          "description": "Basename of the first static word after wrappers and assignments; absent when that word is dynamic.",
          "type": "string"
        },
        "subcommand": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wrappers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "description": "Names of the static flag words after the program, without values.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "argv": {
          "type": "array",
          "items": {}
        },
        "redirects": {
          "type": "array",
          "items": {}
        },
        "stage": {
          "$ref": "#/$defs/shellspec.invocation.Stage"
        },
        "guard": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shellspec.invocation.Guard"
          }
        },
        "context": {
          "$ref": "#/$defs/shellspec.invocation.InvocationContext"
        },
        "cwd": {
          "description": "Working directory relative to the call's; absent once a `cd` was dynamic.",
          "type": "string"
        },
        "remote": {
          "type": "boolean"
        },
        "depth": {
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/shellspec.classification.Category"
        },
        "operation": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shellspec.classification.Effect"
          }
        },
        "rule": {
          "type": "string"
        },
        "unk": {
          "$ref": "#/$defs/shellspec.syntax.UnkReason"
        }
      },
      "required": [
        "index",
        "path",
        "subcommand",
        "wrappers",
        "assignments",
        "flags",
        "argv",
        "redirects",
        "stage",
        "guard",
        "context",
        "remote",
        "depth",
        "category",
        "effects"
