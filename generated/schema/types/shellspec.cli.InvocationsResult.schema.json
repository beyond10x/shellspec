    "shellspec.invocation.Stage": {
      "title": "Stage",
      "description": "The pipeline an invocation is a stage of; a command outside a pipe is the one stage of its own.",
      "x-ess-name": "shellspec.invocation.Stage",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "pipeline": {
          "type": "integer"
        },
        "index": {
          "type": "integer"
        },
        "of": {
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/shellspec.invocation.StageRole"
        }
      },
      "required": [
        "pipeline",
        "index",
        "of",
        "role"
      ],
      "additionalProperties": false
    },
    "shellspec.invocation.StageRole": {
      "title": "StageRole",
      "x-ess-name": "shellspec.invocation.StageRole",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "alone",
        "head",
        "middle",
        "tail"
      ]
    },
    "shellspec.syntax.AndOrOp": {
      "title": "AndOrOp",
      "x-ess-name": "shellspec.syntax.AndOrOp",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "and",
        "or"
      ]
    },
    "shellspec.syntax.UnkReason": {
      "title": "UnkReason",
      "description": "Why shellspec could not say (docs/design.md § 3.3): a region the parser refused, a construct of another dialect, a dynamic program word, a static program no rule names, a nested script deeper than 3.",
      "x-ess-name": "shellspec.syntax.UnkReason",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "syntax",
        "dialect",
        "dynamic",
        "no_rule",
        "depth"
      ]
    }
