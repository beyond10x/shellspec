        "invocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shellspec.invocation.Invocation"
          }
        },
        "dominant": {
          "description": "Index of the first invocation that is not navigate, filter, output or environment (§ 7.1).",
          "type": "integer"
        }
      },
      "required": [
        "ruleset",
        "invocations"
      ],
      "additionalProperties": false
    },
    "shellspec.invocation.Guard": {
      "title": "Guard",
      "description": "Runs only if the invocation at index `after` succeeded (and) or failed (or).",
      "x-ess-name": "shellspec.invocation.Guard",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "op": {
          "$ref": "#/$defs/shellspec.syntax.AndOrOp"
        },
