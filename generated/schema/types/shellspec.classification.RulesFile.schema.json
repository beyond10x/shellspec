          }
        },
        "positionals": {
          "type": "integer"
        },
        "until": {
          "type": "string"
        },
        "assignments": {
          "type": "boolean"
        },
        "unless_next": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip_next": {
          "type": "array",
